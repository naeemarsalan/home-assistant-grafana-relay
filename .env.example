AUTH_TOKEN=LONG_LIVED_ACCESS_TOKEN
HM_SERVICE_URI=http://home.domain.tld/api/services/notify/notify
LISTEN_PORT=12000
LISTEN_HOST=0.0.0.0
HISTORY_FILE=/data/notifications.json
HISTORY_LIMIT=200

# Optional protection for the history UI
# WEB_UI_USERNAME=admin
# WEB_UI_PASSWORD=CHANGE_ME

# Optional secret accepted as X-Webhook-Secret or Authorization: Bearer <secret>
# WEBHOOK_SECRET=CHANGE_ME
